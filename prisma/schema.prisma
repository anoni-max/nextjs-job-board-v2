generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("PRISMA_DATABASE_URL")
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  description String
  applyUrl    String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Candidate {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  skills        String
  education     String
  bio           String?
  createdAt     DateTime @default(now())
}