generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCTION_PRISMA_URL")
}

model Job {
  id               String    @id @default(cuid())
  title            String
  company          String
  location         String
  description      String
  applyUrl         String
  expiresAt        DateTime
  salary           String?
  employmentType   String?
  positions        String?
  postedDate       DateTime?
  qualifications   String?
  responsibilities String?
  sourceEmailId    String?   @unique
  rawEmail         String?
  isApproved       Boolean   @default(false)
  rejected         Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([isApproved, rejected, publishedAt])
}

model Candidate {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  skills        String
  education     String
  bio           String?
  createdAt     DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
