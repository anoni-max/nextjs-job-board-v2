generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCTION_PRISMA_URL")
}

model Job {
  id                String    @id @default(cuid())
  title             String
  company           String
  location          String
  description       String
  applyUrl          String
  applyEmail        String?
  expiresAt         DateTime
  salary            String?
  employmentType    String?
  positions         String?
  postedDate        DateTime?
  qualifications    String?
  responsibilities  String?
  sourceEmailId     String?   @unique
  rawEmail          String?
  isApproved        Boolean   @default(false)
  rejected          Boolean   @default(false)
  marketed          Boolean   @default(false)
  publishedAt       DateTime?
  companyNormalized String?
  duplicateScore    Float?
  duplicateOfId     String?
  duplicateReasons  String?
  duplicateStatus   String    @default("none")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([isApproved, rejected, publishedAt])
  @@index([companyNormalized])
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  skills    String
  education String
  bio       String?
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile Profile?
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  education           String?
  qualifications      String?
  workExperience      String?
  skills              String?
  certifications      String?
  preferredIndustries String?
  preferredTitles     String?
  preferredLocations  String?
  preferredCountries  String?
  expectedSalary      String?
  employmentType      String?
  workPreference      String?
  cvConsent           Boolean  @default(false)
  alertFrequency      String   @default("daily")
  emailAlerts         Boolean  @default(false)
  whatsappAlerts      Boolean  @default(false)
  whatsappNumber      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model JobFeedback {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  rating    String
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  jobId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model JobAd {
  id        String   @id @default(cuid())
  imageData String
  caption   String?
  applyUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  comment   String
  rating    Int?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}
